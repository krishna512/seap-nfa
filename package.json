{
  "name": "vite-tailwind-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite serve",
    "build": "vite build",
    "prepare": "cd ../../../ && husky wp-content/themes/seap/.husky",
    "precommit": "lint-staged",
    "format": "prettier --write ./resources/sass/*.scss || true && git add ."
  },
  "lint-staged": {
    "*": "yarn format",
    "resources/js/**/*.js": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "laravel-vite-plugin": "^1.0.2",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.38",
    "postcss-nested": "^6.0.1",
    "prettier": "^3.2.5",
    "sass": "^1.72.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.6"
  },
  "dependencies": {
    "glob": "^10.3.10",
    "strip-ansi": "^7.1.0"
  }
}
